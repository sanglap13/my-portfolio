# MongoDB Connection String (Required for Contact Form Dashboard)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/portfolio?retryWrites=true&w=majority"

# Admin Dashboard
ADMIN_PASSWORD="your-admin-password"

# Cloudinary — 3 accounts to stay within free tier limits
# Account A — Sequences (scroll animation frames)
CLOUDINARY_A_CLOUD_NAME=
CLOUDINARY_A_API_KEY=
CLOUDINARY_A_API_SECRET=

# Account B — Images (community photos, gallery, hero, projects)
CLOUDINARY_B_CLOUD_NAME=
CLOUDINARY_B_API_KEY=
CLOUDINARY_B_API_SECRET=

# Account C — Reels (videos)
CLOUDINARY_C_CLOUD_NAME=
CLOUDINARY_C_API_KEY=
CLOUDINARY_C_API_SECRET=
